# ============================================================================
# EVIDENCE ANALYSIS - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and configure for your state/use case
#
# QUICK START:
# For Bihar:   RELEVANCE_MODE=strict
# For Haryana: RELEVANCE_MODE=mixed
# ============================================================================

# ===== API CONFIGURATION =====
# Gemini API Token (Required) - Add multiple for rate limit rotation
GEMINI_TOKEN1=your_gemini_api_token_here
GEMINI_TOKEN2=your_second_gemini_api_token_here
GEMINI_TOKEN3=your_third_gemini_api_token_here

# ===== STATE CONFIGURATION =====
# Current state being processed
# Options: BIHAR, HARYANA, or custom state name
STATE_NAME=HARYANA

# ============================================================================
# RELEVANCE SCORING MODE (CRITICAL CONFIGURATION)
# ============================================================================
# This controls how the relevance tag is calculated from Gemini API answers
#
# RELEVANCE_MODE Options:
# -------------------------
# "strict"      - Bihar mode: Only YES/NO answers count
#                 Descriptive explanations are IGNORED
#                 Example: ["YES", "detailed explanation"] → Score based only on YES
#                 Use case: When questions expect strict YES/NO answers
#
# "mixed"       - Haryana mode: Both YES/NO and descriptive answers count
#                 Weighted average based on answer types
#                 Example: ["YES", "detailed explanation"] → Both contribute to score
#                 Use case: When questions can have mixed answer types
#
# "descriptive" - Only descriptive answers count
#                 YES/NO answers are IGNORED
#                 Example: ["YES", "detailed explanation"] → Score based only on explanation
#                 Use case: When only detailed explanations matter
#
RELEVANCE_MODE=mixed
# Default: mixed (for Haryana)

# ============================================================================
# RELEVANCE SCORING THRESHOLDS
# ============================================================================
# These thresholds determine the final relevance tag based on calculated score
# Score range: 0.0 (worst) to 1.0 (best)
#
RELEVANT_THRESHOLD=0.7
# Score >= 0.7 → Tag = "Relevant"
# Recommended: 0.6-0.8 depending on strictness

PARTIALLY_RELEVANT_THRESHOLD=0.4
# Score >= 0.4 and < 0.7 → Tag = "Partially Relevant"
# Score < 0.4 → Tag = "Irrelevant"
# Recommended: 0.3-0.5 depending on tolerance

# ============================================================================
# EXAMPLE CONFIGURATIONS BY STATE
# ============================================================================
#
# --- BIHAR CONFIGURATION (Strict YES/NO only) ---
# STATE_NAME=BIHAR
# RELEVANCE_MODE=strict
# RELEVANT_THRESHOLD=0.7
# PARTIALLY_RELEVANT_THRESHOLD=0.4
#
# --- HARYANA CONFIGURATION (Mixed answers) ---
# STATE_NAME=HARYANA
# RELEVANCE_MODE=mixed
# RELEVANT_THRESHOLD=0.7
# PARTIALLY_RELEVANT_THRESHOLD=0.4
#
# --- RESEARCH/DETAILED MODE (Descriptive only) ---
# STATE_NAME=RESEARCH
# RELEVANCE_MODE=descriptive
# RELEVANT_THRESHOLD=0.6
# PARTIALLY_RELEVANT_THRESHOLD=0.3

# ===== ENROLLMENT CONFIGURATION =====
# Task name that contains enrollment data (exact match required)
# Change this if your enrollment task has a different name
ENROLLMENT_TASK_FILTER=5. Calculate percentage increase in enrolment from last year and create an enrolment report.

# ===== REPORT CONFIGURATION =====
# Chart focus for HTML dashboard
# Options: subject_class_distribution, enrollment_increase
CHART_FOCUS=enrollment_increase

# Show enrollment increase charts and metrics
# Options: true, false
SHOW_ENROLLMENT_INCREASE=true

# Primary metrics to display (comma-separated, no spaces)
# Examples:
#   - Enrollment Increase %,School Performance
#   - Subject Distribution,Class Distribution
PRIMARY_METRICS=Enrollment Increase %,School Performance

# ===== ANSWER FORMAT (Legacy - kept for compatibility) =====
# Use descriptive answers (True) or yes/no answers (False)
USE_DESCRIPTIVE_ANSWERS=True

# ===== PRE-PROCESSOR CONFIGURATION =====
# Set to "yes" to split into multiple files, "no" for single file
SPLIT_FILES=yes
# Rows per file (only used if SPLIT_FILES = "yes")
ROWS_PER_FILE=10000
# Set to True to filter by school_list.csv
USE_SCHOOL_FILTER=False