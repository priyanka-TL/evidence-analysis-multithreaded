# ============================================================
#  Copy this file to .env and fill in your values.
#  cp .env.sample .env
# ============================================================

# ============================================================
#  Gemini API Tokens
#  Each key is an independent rate-limit bucket.
#  Add as many as you have: GEMINI_TOKEN1, GEMINI_TOKEN2, ...
# ============================================================
GEMINI_TOKEN1="your_token_here"
GEMINI_TOKEN2="your_token_here"

# ============================================================
#  Pre-processor  (pre-processor/1-pre-processor.py)
# ============================================================

# "no"  → single output: output-pre-processor/preprocessed_data.csv
# "yes" → multiple files: output-pre-processor/split_1.csv, split_2.csv, ...
#
# When to use "yes":
#   - Input is very large (>1M rows) and you want to process it in batches
#   - You want to resume mid-way through processing a large dataset
#   - You are running on a machine with limited memory
SPLIT_FILES=no

# Rows per main split file (only applies when SPLIT_FILES=yes)
ROWS_PER_FILE=300000

# ============================================================
#  Splitter  (pre-processor/2-csv-splitter.py)
# ============================================================

# Number of parallel sub-split files per main split.
# Each sub-split file is processed by one worker thread.
# Rule of thumb: set to (number of CPU cores) × 2, or match your API token quota.
PARTS=80

# ============================================================
#  Processor  (processor/1-main-parallel-script.py)
# ============================================================

# Gemini model for image analysis.
# Options: gemini-2.5-flash-lite (cheapest), gemini-2.5-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash-lite

# Max API requests per minute per token.
# Check your quota: Google Cloud Console → APIs & Services → Quotas → "Gemini"
# Set to ~90% of your actual limit to avoid hitting 429s.
MAX_RPM_PER_TOKEN=3000

# Max rows processed per input file per worker thread per run.
# Increase to process larger chunks in one go.
MAX_PROCESSED_ROWS=20000

# Flush output to disk every N rows (lower = safer on crash, higher = faster).
FLUSH_INTERVAL=10

# Hard cap on total image download time per image (seconds).
MAX_IMG_SECONDS=120

# Max concurrent image downloads across all workers.
# Lower this if you see bandwidth saturation or OOM errors.
MAX_CONCURRENT_DOWNLOADS=50

# ============================================================
#  Relevant Evidence Cap  (processor/1-main-parallel-script.py)
# ============================================================

# Set to "true" to cap the number of "Relevant" tags per (UUID, Tasks) pair.
# Rows beyond the cap are tagged "notValidated" instead of being processed.
# Set to "false" to validate all evidences (no cap).
ENABLE_RELEVANT_CAP=true

# Max "Relevant" tags allowed per (UUID, Tasks) pair.
MAX_RELEVANT_PER_USER_TASK=2

# ============================================================
#  Pipeline Orchestrator  (run-split-pipeline.py)
# ============================================================
# The orchestrator sets INPUT_DIR and OUTPUT_DIR automatically per split.
# Only override these if you are running processor/1-main-parallel-script.py
# directly (bypassing the orchestrator).
#
# INPUT_DIR=parallel_input_split_1_files
# OUTPUT_DIR=parallel_output_split_1_files
# FINAL_OUTPUT_FILENAME=merged_output.csv
